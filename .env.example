##############################################
# Brunella Agent System – környezeti változók
# Töltsd ki és másold .env néven a projekt gyökerébe
##############################################

# Google Gemini kulcs – a fő orchestratorhoz
GEMINI_API_KEY=your-gemini-api-key

# Qwen 3 Coder (DashScope) beállítások
QWEN_API_KEY=your-dashscope-api-key
QWEN_CODER_MODEL=qwen-coder-plus-latest
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# LangSmith / LangGraph telemetria (opcionális)
LANGSMITH_API_KEY=

# Lokális fallback modell az Ollama konténerhez
OLLAMA_MODEL=qwen3:7b

# Backend szolgáltatások (Docker compose is ezt használja)
DATABASE_URL=postgresql://brunella:secret@db:5432/agents
REDIS_URL=redis://redis:6379/0
\n# The API key required for accessing protected endpoints.\nAPI_KEY=
