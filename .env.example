# This is an example file. Copy it to .env and fill in the values.
#
# This file is loaded by the `run-stack.bat` script and docker-compose,
# as well as `Makefile` commands.

# LangSmith Telemetry (optional, for tracing and debugging)
LANGSMITH_API_KEY="your-langsmith-api-key"
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=Brunella

# --- Agent Models ---

# Main orchestrator and research agent model (Google Gemini)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL_NAME=gemini-1.5-pro-latest

# Coder specialist model (Qwen 3 via DashScope, OpenAI-compatible)
# Fallback is local Ollama if API key is missing.
QWEN_API_KEY="your-qwen-api-key"
QWEN_CODER_MODEL=qwen-coder-plus-latest
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Local model fallback via Ollama service
OLLAMA_MODEL=qwen3:7b

# --- Environment Configuration ---

# Set to "production" to read secrets from Google Secret Manager
# Set to "development" (or leave blank) to use .env values directly
ENVIRONMENT=development
# Required for production mode
GCP_PROJECT_ID=your-gcp-project-id-here

# API Key for securing the backend endpoints
API_KEY=your-secret-api-key
