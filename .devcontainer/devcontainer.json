// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "Node.js & TypeScript",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
			"moby": true,
			"installDockerBuildx": true,
			"installDockerComposeSwitch": true,
			"version": "latest",
			"dockerDashComposeVersion": "v2"
		},
		"ghcr.io/devcontainers/features/powershell:1": {
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/python:1": {
			"installTools": true,
			"optimize": true,
			"enableShared": true,
			"installJupyterlab": true,
			"version": "latest"
		},
		"ghcr.io/natescherer/devcontainers-custom-features/powershell-resources:1": {},
		"ghcr.io/jsburckhardt/devcontainer-features/uv:1": {},
		"ghcr.io/kvokka/features/aicommit2:1": {
			"version": "latest"
		},
		"ghcr.io/joedmck/devcontainer-features/cdktf:1": {},
		"ghcr.io/itsmechlark/features/postgresql:1": {
			"version": "latest"
		},
		"ghcr.io/robbert229/devcontainer-features/postgresql-client:1": {
			"version": "13"
		},
		"ghcr.io/schlich/devcontainer-features/powerlevel10k:1": {},
		"ghcr.io/va-h/devcontainers-features/uv:1": {
			"shellautocompletion": true,
			"version": "latest"
		},
		"ghcr.io/jpawlowski/devcontainer-features/powershell-extended:2": {
			"updateModulesHelp": true,
			"setUserDefaultShell": true,
			"setRootDefaultShell": true,
			"installOhMyPosh": true,
			"installOhMyPoshConfig": true,
			"version": "latest",
			"installMethod": "package",
			"updatePSResourceGet": "release",
			"updatePSReadLine": "release"
		},
		"ghcr.io/gvatsal60/dev-container-features/uv:0": {},
		"ghcr.io/devcontainers-extra/features/aws-cdk:2": {
			"version": "latest"
		},
		"ghcr.io/devcontainers-extra/features/live-server:1": {
			"version": "latest"
		},
		"ghcr.io/devcontainers-extra/features/powerbi-visuals-tools:2": {
			"version": "latest"
		},
		"ghcr.io/devcontainers-extra/features/powershell:1": {
			"version": "latest"
		},
		"ghcr.io/devcontainers-extra/features/uv:1": {
			"version": "latest"
		},
		"ghcr.io/devcontainers-extra/features/vulture:2": {
			"version": "latest"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"georgewfraser.vscode-javac",
				"googlecloudtools.cloudcode"
			]
		}
	}

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "yarn install",

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
