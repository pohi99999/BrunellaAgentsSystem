# A gyökérkönyvtárban található .env.example tartalmaz minden szükséges változót.
# Ha csak a backendhez szeretnél lokális .env-et létrehozni, másold azt ide, vagy
# exportáld az alábbi kulcsokat:
#
# GEMINI_API_KEY=your-gemini-api-key
# QWEN_API_KEY=your-dashscope-api-key
# QWEN_CODER_MODEL=qwen-coder-plus-latest
# QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LANGSMITH_API_KEY=
# OLLAMA_MODEL=qwen3:7b
# DATABASE_URL=postgresql://brunella:secret@localhost:5432/agents
# REDIS_URL=redis://localhost:6379/0
